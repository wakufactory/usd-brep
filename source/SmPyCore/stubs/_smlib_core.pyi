"""USD-free SMLib modeling subset."""

from typing import Any, Sequence


class Brep:
    @property
    def valid(self) -> bool: ...


class PolyBrep:
    def to_numpy_arrays(self) -> dict[str, Any]: ...


class Profile:
    @property
    def points(self) -> list[list[float]]: ...
    @property
    def spline(self) -> bool: ...


def face_info(brep: Brep) -> list[dict[str, Any]]: ...
def offset_brep(brep: Brep, distance: float, *, extended_offset: bool = True,
                self_intersection: bool = True) -> Brep: ...
def shell_brep(brep: Brep, distance: float, *, faces_to_shell: Sequence[int] = (),
               extended_offset: bool = True, self_intersection: bool = True,
               create_solid: bool = True) -> Brep: ...


def create_profile(points: Sequence[Sequence[float]]) -> Profile: ...
def create_spline_profile(points: Sequence[Sequence[float]]) -> Profile: ...
def create_extrude(profile: Profile, origin: tuple[float, float, float], start: float, end: float,
                   axis: tuple[float, float, float] | None = None,
                   xdir: tuple[float, float, float] | None = None) -> Brep: ...
def create_revolve(profile: Profile, origin: tuple[float, float, float], start_angle_deg: float,
                   end_angle_deg: float, axis: tuple[float, float, float] | None = None,
                   xdir: tuple[float, float, float] | None = None) -> Brep: ...


def create_box(origin: tuple[float, float, float], length: float, width: float, height: float) -> Brep: ...
def create_sphere(center: tuple[float, float, float], radius: float) -> Brep: ...
def create_cylinder(base: tuple[float, float, float], radius: float, height: float,
                    axis: tuple[float, float, float] | None = None) -> Brep: ...
def create_cone(base: tuple[float, float, float], radius_base: float, radius_top: float, height: float,
                axis: tuple[float, float, float] | None = None) -> Brep: ...
def create_torus(center: tuple[float, float, float], radius_major: float, radius_minor: float,
                 axis: tuple[float, float, float] | None = None) -> Brep: ...
def create_pyramid(base: tuple[float, float, float], length: float, height: float,
                   axis: tuple[float, float, float] | None = None) -> Brep: ...
def create_cylindrical_box(base: tuple[float, float, float], length: float, inside_radius: float,
                           outside_radius: float, start_angle_deg: float, end_angle_deg: float,
                           axis: tuple[float, float, float] | None = None) -> Brep: ...
def create_partial_sphere(center: tuple[float, float, float], radius: float,
                          start_angle_deg: float, end_angle_deg: float,
                          axis: tuple[float, float, float] | None = None) -> Brep: ...
def create_partial_cone(base: tuple[float, float, float], radius_base: float, radius_top: float,
                        height: float, start_angle_deg: float, end_angle_deg: float,
                        axis: tuple[float, float, float] | None = None) -> Brep: ...
def create_partial_cylinder(base: tuple[float, float, float], radius: float, height: float,
                            start_angle_deg: float, end_angle_deg: float,
                            axis: tuple[float, float, float] | None = None) -> Brep: ...
def create_partial_torus(center: tuple[float, float, float], radius_major: float, radius_minor: float,
                         start_angle_deg: float, end_angle_deg: float,
                         axis: tuple[float, float, float] | None = None) -> Brep: ...
def create_ellipsoid(center: tuple[float, float, float], radius_x: float, radius_y: float,
                     radius_z: float) -> Brep: ...
def create_sphere_no_pole(center: tuple[float, float, float], radius: float) -> Brep: ...
def create_plane(origin: tuple[float, float, float], length: float, width: float) -> Brep: ...
def create_planar_circle(origin: tuple[float, float, float], radius: float) -> Brep: ...
def boolean_union(a: Brep, b: Brep) -> Brep: ...
def boolean_difference(a: Brep, b: Brep) -> Brep: ...
def boolean_intersection(a: Brep, b: Brep) -> Brep: ...
def chamfer_fillet(brep: Brep, radius: float) -> Brep: ...
def circular_fillet(brep: Brep, radius: float) -> Brep: ...
def transform_brep(brep: Brep, scale: tuple[float, float, float], euler: tuple[float, float, float],
                   position: tuple[float, float, float]) -> Brep: ...
def tessellate(
    brep: Brep,
    chord_height_tolerance: float = 0.0,
    curve_angle_tolerance_deg: float = 25.0,
    surface_angle_tolerance_deg: float = 25.0,
) -> PolyBrep | None: ...
